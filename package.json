{
  "name": "open-mouthpiece",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch_openscad_wasm.mjs && vite",
    "dev:lan": "node scripts/fetch_openscad_wasm.mjs && vite --host",
    "build": "npm run static:assets && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "node scripts/check.mjs",
    "sweep": "node scripts/sweep.mjs",
    "docs:params": "node scripts/param_docs.mjs",
    "static:assets": "node scripts/fetch_openscad_wasm.mjs && node scripts/build_static_project.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
